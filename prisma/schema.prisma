generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        Int        @id @default(autoincrement())
  nombre    String
  email     String     @unique
  registros Registro[]
  createdAt DateTime   @default(now())
}

model Zona {
  ogc_fid      Int      @id @default(autoincrement())
  wkb_geometry Unsupported("geometry(MultiPolygon, 4326)")?
  id           Decimal? @db.Decimal(10, 0)
  area         Decimal? @db.Decimal(11, 3)
  pcr          String?  @db.VarChar(100)
  valorpcr     Decimal? @db.Decimal(10, 0)
  nombre       String   @unique @db.VarChar(100)

  registros    Registro[]

  @@map("zonas")
}

model Curva {
  id      Int    @id @default(autoincrement())
  nombre  String @unique
  puntos  Json
}

model Registro {
  id                Int      @id @default(autoincrement())
  zona_id           String
  usuario_id        Int
  fecha             DateTime @default(now())
  inputs            Json     // Guarda todos los campos del formulario
  valor_interpolado Float
  createdAt         DateTime @default(now())

  zona    Zona    @relation(fields: [zona_id], references: [nombre])
  usuario Usuario @relation(fields: [usuario_id], references: [id])
}
